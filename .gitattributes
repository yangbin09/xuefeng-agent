# 统一换行，避免 Windows 检出后 Mac 脚本失效
* text=auto

*.bat      text eol=crlf
*.command  text eol=lf
*.sh       text eol=lf
*.py       text eol=lf
*.html     text eol=lf
*.md       text eol=lf
*.json     text eol=lf

# 二进制：不做换行转换，也不显示 diff
*.db      binary
*.gz      binary
*.png     binary
*.gif     binary
*.xlsx    binary
